<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Full Remove</vendor>
  <vendor_url>https://github.com/Rockeyxx/omarchy-plugin-full-remove</vendor_url>

  <!-- The only root action Full Remove uses. It can run nothing but the
       root-owned helper below, and asks for the password every time
       (auth_admin, never auth_admin_keep). -->
  <action id="io.github.rockeyxx.full-remove.run">
    <description>Remove software with Full Remove</description>
    <message>Full Remove: $(command_line). Only enter your password if you just pressed Confirm in Full Remove and this matches the panel.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/full-remove/full-remove-helper</annotate>
  </action>
</policyconfig>
